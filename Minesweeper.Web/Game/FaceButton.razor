<button class="face-button" @onclick="OnClick">
    <div class="face-circle">
        @if (Mood == GameMood.Smile)
        {
            <div class="face-shape" style="left:10px;top:14px;width:5px;height:5px;border-radius:50%;background:#2b2110;"></div>
            <div class="face-shape" style="right:10px;top:14px;width:5px;height:5px;border-radius:50%;background:#2b2110;"></div>
            <div class="face-shape" style="left:11px;top:21px;width:18px;height:9px;border-radius:0 0 18px 18px;border-bottom:2.5px solid #2b2110;"></div>
        }
        else if (Mood == GameMood.Worried)
        {
            <div class="face-shape" style="left:8px;top:11px;width:8px;height:8px;border-radius:50%;background:#2b2110;"></div>
            <div class="face-shape" style="right:8px;top:11px;width:8px;height:8px;border-radius:50%;background:#2b2110;"></div>
            <div class="face-shape" style="left:15px;top:24px;width:10px;height:10px;border-radius:50%;background:#2b2110;"></div>
        }
        else if (Mood == GameMood.Cool)
        {
            <div class="face-shape" style="left:6px;top:14px;width:28px;height:8px;border-radius:3px;background:#20232a;box-shadow:0 1px 1px rgba(255,255,255,0.25) inset;"></div>
            <div class="face-shape" style="left:11px;top:22px;width:18px;height:8px;border-radius:0 0 18px 18px;border-bottom:2.5px solid #2b2110;"></div>
        }
        else if (Mood == GameMood.Dead)
        {
            <div class="face-shape" style="left:7px;top:12px;width:9px;height:2.4px;background:#2b2110;transform:rotate(45deg);border-radius:2px;"></div>
            <div class="face-shape" style="left:7px;top:12px;width:9px;height:2.4px;background:#2b2110;transform:rotate(-45deg);border-radius:2px;"></div>
            <div class="face-shape" style="right:7px;top:12px;width:9px;height:2.4px;background:#2b2110;transform:rotate(45deg);border-radius:2px;"></div>
            <div class="face-shape" style="right:7px;top:12px;width:9px;height:2.4px;background:#2b2110;transform:rotate(-45deg);border-radius:2px;"></div>
            <div class="face-shape" style="left:14px;top:23px;width:12px;height:6px;border-radius:6px;background:#2b2110;"></div>
        }
    </div>
</button>

@code {
    [Parameter] public GameMood Mood { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
}
