<header class="app-header">
    <div class="app-header-brand">
        <div class="app-header-logo">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                <g stroke="#e7eaee" stroke-width="2" stroke-linecap="round">
                    <line x1="12" y1="2" x2="12" y2="6" />
                    <line x1="12" y1="18" x2="12" y2="22" />
                    <line x1="2" y1="12" x2="6" y2="12" />
                    <line x1="18" y1="12" x2="22" y2="12" />
                    <line x1="5" y1="5" x2="8" y2="8" />
                    <line x1="16" y1="16" x2="19" y2="19" />
                    <line x1="5" y1="19" x2="8" y2="16" />
                    <line x1="16" y1="8" x2="19" y2="5" />
                </g>
                <circle cx="12" cy="12" r="6.2" fill="#1c1f24" stroke="#e7eaee" stroke-width="1" />
                <circle cx="9.7" cy="9.7" r="1.15" fill="#eef1f5" opacity="0.85" />
            </svg>
        </div>
    </div>

    @* Primary navigation lives here now - the fixed bottom footer was removed so the board
       gets that space back. The Castle ecosystem header above already brands the page, so the
       "Minesweeper" title text is dropped to keep this bar slim. *@
    <nav class="app-nav">
        <NavLink class="app-tab" ActiveClass="active" href="/" Match="NavLinkMatch.All">Game</NavLink>
        <NavLink class="app-tab" ActiveClass="active" href="/stats">Stats</NavLink>
        <NavLink class="app-tab" ActiveClass="active" href="/records">Records</NavLink>
    </nav>

    <div class="app-header-actions">
        @if (_fullscreenSupported)
        {
            <button class="help-button" @onclick="ToggleFullscreen" title="Toggle full screen">
                @if (_isFullscreen)
                {
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 3H5a2 2 0 0 0-2 2v4M15 3h4a2 2 0 0 1 2 2v4M9 21H5a2 2 0 0 1-2-2v-4M15 21h4a2 2 0 0 0 2-2v-4" />
                    </svg>
                }
                else
                {
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 9V5a2 2 0 0 1 2-2h4M21 9V5a2 2 0 0 0-2-2h-4M3 15v4a2 2 0 0 0 2 2h4M21 15v4a2 2 0 0 1-2 2h-4" />
                    </svg>
                }
            </button>
        }
        <button class="help-button" @onclick="OnHelpClick">?</button>
    </div>
</header>

@implements IDisposable

@code {
    [Parameter] public EventCallback OnHelpClick { get; set; }

    [Inject] private FullscreenService Fullscreen { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;

    private bool _fullscreenSupported;
    private bool _isFullscreen;
    private DotNetObjectReference<AppHeader>? _selfRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _fullscreenSupported = await Fullscreen.IsSupportedAsync();
            if (_fullscreenSupported)
            {
                // Watch actual fullscreen state so the icon stays correct however it changed -
                // the header's own button, the immersive exit button, Escape, or a system gesture.
                _selfRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("msFullscreen.watch", _selfRef);
                StateHasChanged();
            }
        }
    }

    private async Task ToggleFullscreen()
    {
        if (_isFullscreen)
        {
            await Fullscreen.ExitAsync();
        }
        else
        {
            await Fullscreen.EnterAsync();
        }
        // OnFullscreenChanged will reconcile the real state; this keeps the icon snappy meanwhile.
        _isFullscreen = !_isFullscreen;
    }

    [JSInvokable]
    public Task OnFullscreenChanged(bool isFullscreen)
    {
        _isFullscreen = isFullscreen;
        return InvokeAsync(StateHasChanged);
    }

    public void Dispose() => _selfRef?.Dispose();
}
