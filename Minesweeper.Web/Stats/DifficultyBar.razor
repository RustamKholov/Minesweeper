@if (SecondsValue.HasValue)
{
    <div class="difficulty-bar-row">
        <span class="difficulty-bar-label">@Label</span>
        <div class="difficulty-bar-track">
            <div class="difficulty-bar-fill" style="width:@(WidthPercent)%;"></div>
        </div>
        <span class="difficulty-bar-value">@(SecondsValue)s</span>
    </div>
}

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public int? SecondsValue { get; set; }
    [Parameter] public int MaxSecondsAcrossDifficulties { get; set; } = 1;

    private int WidthPercent => SecondsValue is null
        ? 0
        : Math.Max(6, (int)Math.Round(SecondsValue.Value / (double)Math.Max(1, MaxSecondsAcrossDifficulties) * 100));
}
